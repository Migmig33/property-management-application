@{
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}
<div class="p-4 sm:p-6 space-y-6" ng-init="initAudit(); currentPage = 'audit'; " ng-cloak>
    <div>
        <h1 class="text-slate-900 text-xl font-semibold">Audit Trail</h1>
        <p ng-if="!isLoading" class="text-slate-500 text-sm">
            Full history of system events, user actions, and security incidents.
        </p>
        <div ng-if="isLoading" class="h-4 w-64 bg-slate-200 rounded animate-pulse mt-1"></div>
    </div>

    <div ng-if="isLoading" class="grid grid-cols-2 sm:grid-cols-4 gap-3 animate-pulse">
        <div ng-repeat="i in [1, 2, 3, 4]" class="bg-white rounded-2xl px-4 py-3 border border-slate-100 shadow-sm text-left flex flex-col">
            <div class="w-7 h-7 bg-slate-200 rounded-lg mb-2"></div>
            <div class="h-6 w-12 bg-slate-200 rounded mb-1"></div>
            <div class="h-3 w-16 bg-slate-200 rounded mt-1"></div>
        </div>
    </div>

    <div ng-if="!isLoading" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <button ng-repeat="type in auditTypes"
                ng-click="setFilter(type)"
                class="bg-white rounded-2xl px-4 py-3 border shadow-sm text-left transition-all focus:outline-none"
                ng-class="filter === type ? 'border-green-300 ring-2 ring-green-200' : 'border-slate-100 hover:border-slate-200'">

            <div class="w-7 h-7 rounded-lg flex items-center justify-center mb-2" ng-class="getAuditBg(type)">

                <svg ng-if="type === 'login'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>

                <svg ng-if="type === 'settings'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>

                <svg ng-if="type === 'security'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>

                <svg ng-if="type === 'user'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>

            </div>
            <p class="text-lg font-bold text-slate-900">{{ counts[type] || 0 }}</p>
            <p class="text-xs text-slate-500 capitalize">{{ type }}</p>
        </button>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">

        <div class="px-5 py-4 border-b border-slate-100 flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input type="text"
                       placeholder="Search events, actors, IPs…"
                       ng-model="searchQuery"
                       class="w-full pl-9 pr-4 py-2.5 text-sm border border-slate-200 rounded-xl bg-slate-50 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" />
            </div>

            <div class="flex gap-1.5 flex-wrap">
                <button ng-repeat="f in typeFilters"
                        ng-click="setFilter(f.id)"
                        class="px-3 py-2 rounded-xl text-xs font-medium transition-all capitalize focus:outline-none"
                        ng-class="filter === f.id ? 'bg-green-600 text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'">
                    {{ f.label }}
                </button>
            </div>
        </div>

        <div ng-if="isLoading" class="divide-y divide-slate-50 animate-pulse">
            <div ng-repeat="i in [1, 2, 3, 4, 5]" class="flex items-start gap-4 px-5 py-4">
                <div class="w-8 h-8 rounded-xl bg-slate-200 shrink-0 mt-0.5"></div>

                <div class="flex-1 min-w-0 space-y-2 mt-1">
                    <div class="h-3.5 w-3/4 bg-slate-200 rounded"></div>
                    <div class="flex gap-2">
                        <div class="h-3 w-20 bg-slate-200 rounded"></div>
                        <div class="h-3 w-28 bg-slate-200 rounded"></div>
                    </div>
                </div>

                <div class="shrink-0 flex flex-col items-end gap-1.5 mt-1">
                    <div class="h-3 w-16 bg-slate-200 rounded"></div>
                    <div class="h-3 w-12 bg-slate-200 rounded"></div>
                </div>

                <div class="shrink-0 w-14 h-5 bg-slate-200 rounded-full mt-0.5"></div>
            </div>
        </div>

        <div ng-show="!isLoading && (auditLogs | filter:auditFilter).length === 0" class="py-16 text-center">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-200 mx-auto mb-3">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            </svg>
            <p class="text-slate-500 text-sm">No events match your filter.</p>
        </div>

        <div class="divide-y divide-slate-50" ng-show="!isLoading && (auditLogs | filter:auditFilter).length > 0">
            <div ng-repeat="entry in filteredLogs = (auditLogs | filter:auditFilter)"
                 class="flex items-start gap-4 px-5 py-4 hover:bg-slate-50/60 transition-colors">

                <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0 mt-0.5" ng-class="getAuditBg(entry.type)">
                    <svg ng-if="entry.type === 'login'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>
                    <svg ng-if="entry.type === 'settings'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                    <svg ng-if="entry.type === 'security'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                    <svg ng-if="entry.type === 'user'" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
                </div>

                <div class="flex-1 min-w-0">
                    <p class="text-sm text-slate-800 leading-snug">{{ entry.message }}</p>
                    <div class="flex flex-wrap items-center gap-2 mt-1">
                        <span class="text-xs text-slate-500 font-medium">{{ entry.actor }}</span>
                        <span ng-if="entry.ip" class="flex items-center gap-2">
                            <span class="text-slate-300">&middot;</span>
                            <span class="text-xs text-slate-400 font-mono">{{ entry.ip }}</span>
                        </span>
                    </div>
                </div>

                <div class="shrink-0 text-right">
                    <p class="text-xs text-slate-500">{{ entry.date }}</p>
                    <p class="text-xs text-slate-400">{{ entry.time }}</p>
                </div>

                <span class="shrink-0 self-start inline-flex px-2 py-0.5 rounded-full text-[11px] font-medium capitalize" ng-class="getAuditBg(entry.type)">
                    {{ entry.type }}
                </span>
            </div>
        </div>

        <div ng-if="!isLoading" class="px-5 py-3 border-t border-slate-100 bg-slate-50/50">
            <p class="text-xs text-slate-400">
                Showing {{ filteredLogs.length || 0 }} of {{ auditLogs.length }} events
            </p>
        </div>
    </div>
</div>