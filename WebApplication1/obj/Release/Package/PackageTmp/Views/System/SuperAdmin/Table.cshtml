@{
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}
<div class="p-4 sm:p-6 space-y-6" ng-init="initLookup(); currentPage = 'table';" ng-cloak>

    <!-- Header -->
    <div>
        <h1 class="text-slate-900 text-xl font-semibold">Lookup Tables</h1>
        <p ng-if="!isLoading" class="text-slate-500 text-sm">
            Manage global dropdown options used across the platform.
        </p>
        <!-- Header Skeleton -->
        <div ng-if="isLoading" class="h-4 w-72 bg-slate-200 rounded animate-pulse mt-1"></div>
    </div>

    <!-- Info banner -->
    <div class="flex items-start gap-3 bg-green-50 border border-green-100 rounded-2xl px-4 py-3">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-green-600 shrink-0 mt-0.5">
            <ellipse cx="12" cy="5" rx="9" ry="3" />
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
        </svg>
        <p class="text-sm text-green-800">
            Changes here apply platform-wide instantly. Removing an item does not affect existing records that already reference it.
        </p>
    </div>

    <!-- Tables -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
            <p ng-if="!isLoading" class="text-sm font-semibold text-slate-900">
                {{ lookups.length }} lookup tables
            </p>
            <p ng-if="!isLoading" class="text-xs text-slate-400">
                {{ getTotalItems() }} total items
            </p>

            <!-- Toolbar Skeleton -->
            <div ng-if="isLoading" class="h-4 w-28 bg-slate-200 rounded animate-pulse"></div>
            <div ng-if="isLoading" class="h-3 w-20 bg-slate-200 rounded animate-pulse"></div>
        </div>

        <!-- Skeleton Loading List -->
        <div ng-if="isLoading" class="divide-y divide-slate-100 animate-pulse">
            <div ng-repeat="i in [1, 2, 3, 4, 5]" class="flex items-center gap-4 px-5 py-4">
                <!-- Icon Placeholder -->
                <div class="w-8 h-8 bg-slate-200 rounded-xl shrink-0"></div>

                <!-- Content Placeholder -->
                <div class="flex-1 min-w-0 space-y-1.5">
                    <div class="h-4 w-1/4 bg-slate-200 rounded"></div>
                    <div class="h-3 w-1/2 bg-slate-200 rounded"></div>
                </div>

                <!-- Badge Placeholder -->
                <div class="w-16 h-5 bg-slate-200 rounded-full shrink-0"></div>

                <!-- Chevron Placeholder -->
                <div class="w-4 h-4 bg-slate-200 rounded shrink-0"></div>
            </div>
        </div>

        <!-- Loaded List -->
        <div ng-if="!isLoading" class="divide-y divide-slate-100">
            <div ng-repeat="table in lookups track by table.id">

                <!-- Row header (Toggle) -->
                <button ng-click="toggle(table.id)"
                        class="w-full flex items-center gap-4 px-5 py-4 hover:bg-slate-50/70 transition-colors text-left focus:outline-none">
                    <div class="w-8 h-8 bg-green-50 rounded-xl flex items-center justify-center shrink-0">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-green-600">
                            <ellipse cx="12" cy="5" rx="9" ry="3" />
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-slate-900">{{ table.name }}</p>
                        <p class="text-xs text-slate-400 mt-0.5 truncate">{{ table.description }}</p>
                    </div>
                    <span class="text-xs text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full shrink-0">
                        {{ table.items.length }} items
                    </span>

                    <!-- Chevron Down -->
                    <svg ng-show="expanded === table.id" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400 shrink-0 transition-transform">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                    <!-- Chevron Right -->
                    <svg ng-show="expanded !== table.id" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400 shrink-0 transition-transform">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </button>

                <!-- Expanded editor -->
                <div ng-show="expanded === table.id" class="overflow-hidden transition-all duration-300 ease-in-out">
                    <div class="px-5 pb-5 pt-1 bg-slate-50/50 border-t border-slate-100">

                        <!-- Items grid -->
                        <div class="flex flex-wrap gap-2 mb-3 pt-3">
                            <span ng-repeat="item in table.items"
                                  class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 text-sm text-slate-700 shadow-sm">
                                {{ item }}
                                <button ng-click="removeItem(table.id, item)"
                                        class="text-slate-400 hover:text-red-500 transition-colors focus:outline-none"
                                        title="Remove item">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18" />
                                        <line x1="6" y1="6" x2="18" y2="18" />
                                    </svg>
                                </button>
                            </span>

                            <p ng-show="table.items.length === 0" class="text-xs text-slate-400 italic">
                                No items yet — add one below.
                            </p>
                        </div>

                        <!-- Add input -->
                        <div class="flex gap-2 max-w-sm">
                            <input type="text"
                                   ng-model="newItems[table.id]"
                                   ng-keydown="$event.keyCode === 13 && addItem(table.id)"
                                   placeholder="Type new item and press Enter…"
                                   class="flex-1 px-3 py-2 text-sm border border-slate-200 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" />

                            <button ng-click="addItem(table.id)"
                                    class="flex items-center gap-1.5 px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-xl transition-all focus:outline-none">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="5" x2="12" y2="19" />
                                    <line x1="5" y1="12" x2="19" y2="12" />
                                </svg>
                                Add
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>